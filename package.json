{
  "name": "agentlaunch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Order-flow signal and alert system for BTC/ETH/SOL perpetuals (alerts only, no execution)",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "collect": "tsx src/cli/collect.ts",
    "replay": "tsx src/cli/replay.ts",
    "report": "tsx src/cli/report.ts",
    "footprint": "tsx src/cli/footprint.ts",
    "heatmap": "tsx src/cli/heatmap.ts",
    "gex": "tsx src/cli/gex.ts",
    "compare": "tsx src/cli/compare.ts",
    "tune": "tsx src/cli/tune.ts",
    "backfill": "tsx src/cli/backfill.ts",
    "seed-demo": "tsx src/cli/seed-demo.ts",
    "seed-synthetic": "tsx src/cli/seed-synthetic.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\" \"dashboard/tests/**/*.test.ts\"",
    "dashboard:install": "npm install --prefix dashboard",
    "dashboard": "npm run dev --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard",
    "dashboard:typecheck": "npm run typecheck --prefix dashboard",
    "dashboard:start": "npm run start --prefix dashboard"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
